{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "description": "Stride Log — running & cross-training load coach",
  "author": "Stride Log",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n next,electron -c green,cyan \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "electron-builder --config electron-builder.yml",
    "electron:build:mac": "electron-builder --mac --config electron-builder.yml",
    "electron:build:win": "electron-builder --win --config electron-builder.yml",
    "electron:build:linux": "electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "1.6.1",
    "ai": "^7.0.64",
    "better-auth": "^1.6.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "wait-on": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25",
      "app-builder-lib>@noble/hashes": "1.8.0",
      "electron>@electron/get": "3.1.0"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
